   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/icon-maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "/assets/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
