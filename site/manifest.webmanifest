{
 "id": "/app/",
 "name": "FFMPA Kids News",
 "short_name": "FFMPA",
 "description": "Real news made for kids aged 5 to 15. Short, calm stories at three reading levels, twice a day, checked by human editors. No links out, no tracking. Free to start.",
 "start_url": "/app/?source=homescreen",
 "scope": "/",
 "display": "standalone",
 "display_override": [
  "standalone",
  "minimal-ui"
 ],
 "orientation": "portrait",
 "background_color": "#FFFFFF",
 "theme_color": "#FFFFFF",
 "lang": "en",
 "dir": "ltr",
 "categories": [
  "education",
  "news",
  "kids"
 ],
 "icons": [
  {
   "src": "/assets/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
